<!DOCTYPE html>
<html>
<head>
	<meta charset="utf-8" />
	<title><%= caseItem.title %></title>
	<style>
		:root {
			--bg: #121212; --fg: #e8e8e8; --muted: #aaa; --border: #333;
			--input-bg: #1e1e1e; --input-border: #444; --link: #8ab4f8;
			--alert-bg: #3a1f1f; --alert-fg: #ff6b6b; --alert-border: #6b2b2b;
		}
		@media (prefers-color-scheme: light) {
			:root {
				--bg: #fff; --fg: #222; --muted: #555; --border: #ddd;
				--input-bg: #fff; --input-border: #ccc; --link: #0645ad;
				--alert-bg: #fdecea; --alert-fg: #b00020; --alert-border: #f5c6cb;
			}
		}
		body { font-family: system-ui, sans-serif; max-width: 900px; margin: 40px auto; color: var(--fg); background: var(--bg); }
		a { color: var(--link); }
		header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
		section { margin-bottom: 32px; }
		table { width: 100%; border-collapse: collapse; margin-bottom: 12px; }
		th, td { text-align: left; padding: 8px; border-bottom: 1px solid var(--border); vertical-align: top; }
		.badge { padding: 2px 8px; border-radius: 10px; font-size: 12px; color: #fff; }
		.badge.verified { background: #c0392b; }
		.badge.suspected { background: #999; }
		form.inline { display: inline; }
		textarea { width: 100%; box-sizing: border-box; padding: 8px; background: var(--input-bg); color: var(--fg); border: 1px solid var(--input-border); border-radius: 4px; }
		input, select { padding: 6px; background: var(--input-bg); color: var(--fg); border: 1px solid var(--input-border); border-radius: 4px; }
		.history { font-size: 12px; color: var(--muted); }
		.history .recent-change { background: #fff3cd; color: #7a5b00; border-radius: 3px; padding: 2px 4px; }
		.note { border-bottom: 1px solid var(--border); padding: 8px 0; }
		.note .meta { font-size: 12px; color: var(--muted); }
		.alert { background: var(--alert-bg); color: var(--alert-fg); border: 1px solid var(--alert-border); padding: 10px 14px; border-radius: 4px; margin-bottom: 20px; }
	</style>
</head>
<body>
	<p><a href="/">&larr; Back to cases</a></p>
	<% if (error) { %><div class="alert"><%= error %></div><% } %>
	<header>
		<style>
			.logo-row { display: inline-flex; align-items: center; gap: 12px; }
			.logo-row img { height: 48px; width: auto; object-fit: contain; display: block; }
			/* make the following h1 sit inline with the logo and remove default margins */
			.logo-row + h1 { display: inline-block; vertical-align: middle; margin: 0; }
		</style>
		<div class="logo-row">
			<img src="/images/ubs.png" alt="UBS logo">
		</div>
		<h1><%= caseItem.title %></h1>
		<div style="text-align: right;">
			<div>Welcome <%= userInfo.username %> (<%= userInfo.role %>)</div>
			<div>
				<a href="/account/password">Change password</a>
				<% if (userInfo.perms.canManageUsers) { %> <a href="/users">Manage users</a><% } %>
				<% if (userInfo.perms.canViewAuditLog) { %> <a href="/audit-log">Audit log</a><% } %>
				<a href="/logout">Log Out</a>
			</div>
			<% if (userInfo.perms.canManageUsers) { %>
			<div>
				<form class="inline" method="post" action="/cases/<%= caseItem.id %>/check-names">
					<button type="submit">Force check all names</button>
				</form>
				<% if (userInfo.perms.canDeleteCases) { %>
					<form class="inline" method="post" action="/cases/<%= caseItem.id %>/delete" onsubmit="return confirm('Delete this entire case? This cannot be undone.')">
						<button type="submit">Delete case</button>
					</form>
				<% } %>
			</div>
			<% } %>
		</div>
	</header>

	<section>
		<h2>Linked identities</h2>
		<table>
			<thead>
				<tr><th>Platform</th><th>User ID</th><th>Last known name</th><th>Status</th><th>Name history</th><th>Actions</th></tr>
			</thead>
			<tbody>
				<% identities.forEach((identity) => { %>
					<tr>
						<td><%= identity.platform %></td>
						<td><%= identity.platform_user_id %></td>
						<td>
							<%= identity.username || '(unchecked)' %>
							<% if (identity.display_name && identity.display_name !== identity.username) { %>
								(<%= identity.display_name %>)
							<% } %>
						</td>
						<td><span class="badge <%= identity.status %>"><%= identity.status %></span></td>
						<td class="history">
							<% const idHistory = histories[identity.id] || []; %>
							<% idHistory.forEach((h, idx) => { %>
								<div class="utc-change" data-utc="<%= h.changed_at %>" data-initial="<%= idx === idHistory.length - 1 %>"><span class="utc-time" data-utc="<%= h.changed_at %>"><%= h.changed_at %></span>: <%= h.username %> / <%= h.display_name %></div>
							<% }) %>
							<% if (idHistory.length === 0) { %>
								<em>no changes logged</em>
							<% } %>
						</td>
						<td>
							<% if (userInfo.perms.canEditCases) { %>
								<% if (identity.status === 'verified') { %>
									<form class="inline" method="post" action="/identities/<%= identity.id %>/unverify">
										<button type="submit">Unverify</button>
									</form>
								<% } else { %>
									<form class="inline" method="post" action="/identities/<%= identity.id %>/verify">
										<button type="submit">Mark verified</button>
									</form>
								<% } %>
								<form class="inline" method="post" action="/identities/<%= identity.id %>/delete" onsubmit="return confirm('Remove this linked identity?')">
									<button type="submit">Remove</button>
								</form>
							<% } %>
						</td>
					</tr>
				<% }) %>
			</tbody>
		</table>

		<% if (userInfo.perms.canAddIdentities) { %>
		<h3>Link a new identity</h3>
		<form method="post" action="/cases/<%= caseItem.id %>/identities">
			<select name="platform" required>
				<option value="discord">Discord</option>
				<option value="roblox">Roblox</option>
			</select>
			<input type="text" name="platformUserId" placeholder="Platform user ID" required />
			<% if (userInfo.perms.canEditCases) { %>
				<select name="status">
					<option value="suspected">Suspected</option>
					<option value="verified">Verified alt/alias</option>
				</select>
			<% } %>
			<button type="submit">Add link</button>
		</form>
		<% } %>
	</section>

	<section>
		<h2>Notes</h2>
		<% if (userInfo.perms.canAddIdentities) { %>
		<form method="post" action="/cases/<%= caseItem.id %>/notes" enctype="multipart/form-data">
			<textarea name="body" rows="3" placeholder="Add a note..." required></textarea>
			<input type="file" name="files" multiple />
			<button type="submit">Add note</button>
		</form>
		<% } %>
		<% notes.forEach((note) => { %>
			<div class="note">
				<div class="meta"><%= note.author || 'unknown' %> &middot; <span class="utc-time" data-utc="<%= note.created_at %>"><%= note.created_at %></span></div>
				<div><%= note.body %></div>
				<% if (note.files && note.files.length > 0) { %>
					<div class="files">
						<% note.files.forEach((f) => { %>
							<a href="/files/<%= f.id %>"><%= f.filename %></a>
						<% }) %>
					</div>
				<% } %>
				<% if (userInfo.perms.canDeleteNotes) { %>
					<form class="inline" method="post" action="/notes/<%= note.id %>/delete" onsubmit="return confirm('Delete this note?')">
						<button type="submit">Delete</button>
					</form>
				<% } %>
			</div>
		<% }) %>
	</section>
	<script>
		// Stored timestamps are UTC ("YYYY-MM-DD HH:MM:SS"); localize them to the viewer's timezone.
		document.querySelectorAll(".utc-time").forEach((el) => {
			const parsed = new Date(el.dataset.utc.replace(" ", "T") + "Z");
			if (!isNaN(parsed)) el.textContent = parsed.toLocaleString();
		});

		// Highlight name changes that happened within the last 24 hours (skip the initial name).
		const DAY_MS = 24 * 60 * 60 * 1000;
		document.querySelectorAll(".utc-change").forEach((el) => {
			if (el.dataset.initial === "true") return;
			const parsed = new Date(el.dataset.utc.replace(" ", "T") + "Z");
			if (!isNaN(parsed) && Date.now() - parsed.getTime() < DAY_MS) {
				el.classList.add("recent-change");
			}
		});
	</script>
</body>
</html>
