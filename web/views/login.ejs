<!DOCTYPE html>
<html>
<head>
	<meta charset="utf-8" />
	<title>UBS Login</title>
	<style>
		:root {
			--bg: #121212; --fg: #e8e8e8; --muted: #aaa; --border: #333;
			--input-bg: #1e1e1e; --input-border: #444;
		}
		@media (prefers-color-scheme: light) {
			:root { --bg: #fff; --fg: #222; --muted: #777; --border: #ddd; --input-bg: #fff; --input-border: #ccc; }
		}
		body { font-family: system-ui, sans-serif; max-width: 400px; margin: 80px auto; color: var(--fg); background: var(--bg); }
		input { display: block; width: 100%; margin-bottom: 12px; padding: 8px; box-sizing: border-box; background: var(--input-bg); color: var(--fg); border: 1px solid var(--input-border); border-radius: 4px; }
		button { padding: 8px 16px; }
		.error { color: #ff6b6b; margin-bottom: 12px; }
	</style>
</head>
<body>
	<div style="display:flex; align-items:center; gap:12px;"></div>
			<img src="/images/ubs.png" alt="UBS logo" style="height:48px; width:auto; object-fit:contain;">
		</div>
	<h1>UBS Login</h1>
	<% if (error) { %><div class="error"><%= error %></div><% } %>
	<form method="post" action="/login">
		<input type="text" name="username" placeholder="Username" required autocomplete="username" />
		<input type="password" name="password" placeholder="Password" required autocomplete="current-password" />
		<input type="text" name="totpToken" placeholder="6-digit authenticator code" required autocomplete="one-time-code" />
		<button type="submit">Log in</button>
	</form>
</body>
</html>
