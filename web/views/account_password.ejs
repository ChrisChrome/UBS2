<!DOCTYPE html>
<html>
<head>
	<meta charset="utf-8" />
	<title>Change Password</title>
	<style>
		:root {
			--bg: #121212; --fg: #e8e8e8; --muted: #aaa; --border: #333;
			--input-bg: #1e1e1e; --input-border: #444; --link: #8ab4f8;
		}
		@media (prefers-color-scheme: light) {
			:root { --bg: #fff; --fg: #222; --muted: #777; --border: #ddd; --input-bg: #fff; --input-border: #ccc; --link: #0645ad; }
		}
		body { font-family: system-ui, sans-serif; max-width: 480px; margin: 60px auto; color: var(--fg); background: var(--bg); }
		a { color: var(--link); }
		input { display: block; width: 100%; margin-bottom: 12px; padding: 8px; box-sizing: border-box; background: var(--input-bg); color: var(--fg); border: 1px solid var(--input-border); border-radius: 4px; }
		.error { color: #ff6b6b; margin-bottom: 12px; }
		.success { color: #4caf50; margin-bottom: 12px; }
	</style>
</head>
<body>
	<p><a href="/">&larr; Back to cases</a></p>
	<h1>Change Password</h1>
	<% if (error) { %><div class="error"><%= error %></div><% } %>
	<% if (success) { %><div class="success">Password updated.</div><% } %>
	<form method="post" action="/account/password">
		<input type="password" name="currentPassword" placeholder="Current password" required autocomplete="current-password" />
		<input type="password" name="newPassword" placeholder="New password" required autocomplete="new-password" />
		<input type="password" name="confirmPassword" placeholder="Confirm new password" required autocomplete="new-password" />
		<button type="submit">Update password</button>
	</form>
</body>
</html>
