<!DOCTYPE html>
<html>
<head>
	<meta charset="utf-8" />
	<title>UBS Dashboard</title>
	<style>
		:root {
			--bg: #121212; --fg: #e8e8e8; --muted: #aaa; --border: #333;
			--card: #1e1e1e; --link: #8ab4f8;
		}
		@media (prefers-color-scheme: light) {
			:root { --bg: #fff; --fg: #222; --muted: #777; --border: #ddd; --card: #f4f4f4; --link: #0645ad; }
		}
		body { font-family: system-ui, sans-serif; max-width: 800px; margin: 40px auto; color: var(--fg); background: var(--bg); }
		a { color: var(--link); }
		header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
		table { width: 100%; border-collapse: collapse; }
		th, td { text-align: left; padding: 8px; border-bottom: 1px solid var(--border); }
		a.button, button { padding: 6px 12px; }
		form.inline { display: inline; }
	</style>
</head>
<body>
	<header>
		<div style="display:flex; align-items:center; gap:12px;"></div>
			<img src="/images/ubs.png" alt="UBS logo" style="height:48px; width:auto; object-fit:contain;">
		</div>
		<h1>Cases</h1>
		<div>
			<div style="text-align: right;">
				<div>Welcome <%= userInfo.username %> (<%= userInfo.role %>)</div>
				<div>
					<a href="/account/password">Change password</a>
					<% if (userInfo.perms.canManageUsers) { %> <a href="/users">Manage users</a><% } %>
					<% if (userInfo.perms.canViewAuditLog) { %> <a href="/audit-log">Audit log</a><% } %>
					<a href="/logout">Log Out</a>
				</div>
			</div>
		</div>
	</header>
	<% if (userInfo.perms.canEditCases) { %><p><a class="button" href="/cases/new">+ New case</a></p><% } %>
	<table>
		<thead><tr><th>Title</th><th>Linked IDs</th><th>Updated</th></tr></thead>
		<tbody>
			<% cases.forEach((c) => { %>
				<tr>
					<td><a href="/cases/<%= c.id %>"><%= c.title %></a></td>
					<td><%= c.identity_count %></td>
					<td><span class="utc-time" data-utc="<%= c.updated_at %>"><%= c.updated_at %></span></td>
				</tr>
			<% }) %>
		</tbody>
	</table>
	<script>
		// Stored timestamps are UTC ("YYYY-MM-DD HH:MM:SS"); localize them to the viewer's timezone.
		document.querySelectorAll(".utc-time").forEach((el) => {
			const parsed = new Date(el.dataset.utc.replace(" ", "T") + "Z");
			if (!isNaN(parsed)) el.textContent = parsed.toLocaleString();
		});
	</script>
</body>
</html>
