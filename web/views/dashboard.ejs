<!DOCTYPE html>
<html>
<head>
	<meta charset="utf-8" />
	<title>UBS Dashboard</title>
	<style>
		body { font-family: system-ui, sans-serif; max-width: 800px; margin: 40px auto; color: #222; }
		header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
		table { width: 100%; border-collapse: collapse; }
		th, td { text-align: left; padding: 8px; border-bottom: 1px solid #ddd; }
		a.button, button { padding: 6px 12px; }
		form.inline { display: inline; }
	</style>
</head>
<body>
	<header>
		<h1>Cases</h1>
		<div>
			<div>Welcome <%= username %> (<%= role %>)</div>
			<div>
				<a href="/account/password">Change password</a>
				<% if (canManageUsers) { %><a href="/users">Manage users</a><% } %>
				<% if (canViewAuditLog) { %><a href="/audit-log">Audit log</a><% } %>
				<a href="/logout">Log Out</a>
			</div>
		</div>
	</header>
	<% if (canEditCases) { %><p><a class="button" href="/cases/new">+ New case</a></p><% } %>
	<table>
		<thead><tr><th>Title</th><th>Linked IDs</th><th>Updated</th></tr></thead>
		<tbody>
			<% cases.forEach((c) => { %>
				<tr>
					<td><a href="/cases/<%= c.id %>"><%= c.title %></a></td>
					<td><%= c.identity_count %></td>
					<td><span class="utc-time" data-utc="<%= c.updated_at %>"><%= c.updated_at %></span></td>
				</tr>
			<% }) %>
		</tbody>
	</table>
	<script>
		// Stored timestamps are UTC ("YYYY-MM-DD HH:MM:SS"); localize them to the viewer's timezone.
		document.querySelectorAll(".utc-time").forEach((el) => {
			const parsed = new Date(el.dataset.utc.replace(" ", "T") + "Z");
			if (!isNaN(parsed)) el.textContent = parsed.toLocaleString();
		});
	</script>
</body>
</html>
