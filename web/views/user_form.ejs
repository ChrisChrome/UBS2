<!DOCTYPE html>
<html>
<head>
	<meta charset="utf-8" />
	<title><%= mode === 'new' ? 'New User' : 'Edit User' %></title>
	<style>
		:root {
			--bg: #121212; --fg: #e8e8e8; --input-bg: #1e1e1e; --input-border: #444; --link: #8ab4f8;
		}
		@media (prefers-color-scheme: light) {
			:root { --bg: #fff; --fg: #222; --input-bg: #fff; --input-border: #ccc; --link: #0645ad; }
		}
		body { font-family: system-ui, sans-serif; max-width: 480px; margin: 60px auto; color: var(--fg); background: var(--bg); }
		a { color: var(--link); }
		input, select { display: block; width: 100%; margin-bottom: 12px; padding: 8px; box-sizing: border-box; background: var(--input-bg); color: var(--fg); border: 1px solid var(--input-border); border-radius: 4px; }
		.error { color: #ff6b6b; margin-bottom: 12px; }
	</style>
</head>
<body>
	<p><a href="/users">&larr; Back to users</a></p>
	<h1><%= mode === 'new' ? 'New User' : 'Edit User' %></h1>
	<% if (error) { %><div class="error"><%= error %></div><% } %>
	<form method="post" action="<%= mode === 'new' ? '/users' : `/users/${user.id}` %>">
		<input type="text" name="username" placeholder="Username" value="<%= user ? user.username : '' %>" required />
		<input type="password" name="password" placeholder="<%= mode === 'new' ? 'Password' : 'New password (leave blank to keep current)' %>" <%= mode === 'new' ? 'required' : '' %> autocomplete="new-password" />
		<select name="role" required>
			<% roles.forEach((r) => { %>
				<option value="<%= r %>" <%= user && user.role === r ? 'selected' : '' %>><%= r %></option>
			<% }) %>
		</select>
		<button type="submit"><%= mode === 'new' ? 'Create user' : 'Save changes' %></button>
	</form>
</body>
</html>
